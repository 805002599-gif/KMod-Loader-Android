<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>kmod-art</AssemblyName>
    <RootNamespace>KmodArt</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>
  <!-- CUE4Parse and its dependencies come from lib\ (built from the CUE4Parse sources; not committed) -->
  <ItemGroup>
    <Reference Include="lib\*.dll" Exclude="lib\oodle-data-shared.dll;lib\zlib-ng2.dll">
      <Private>true</Private>
    </Reference>
    <None Include="lib\oodle-data-shared.dll;lib\zlib-ng2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="vendor\astcenc\bin\*.exe" Link="astcenc\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
